# Адрес Redis. Внутри docker compose указываем DNS-имя сервиса, а не localhost.
REDIS_URL=redis://redis:6379/0

# Имя потока событий Redis Stream.
LOGPULSE_STREAM=logpulse:events

# Имя группы потребителей (worker).
LOGPULSE_GROUP=logpulse-workers

# Порог "медленного" запроса в миллисекундах (score для logpulse:slow).
SLOW_THRESHOLD_MS=500

# Хост-порт, на который публикуется HTTP API (по умолчанию 8000).
API_PORT=8000
